    "bug_white": {
      "id": 3400,
      "on_end": [
        {
          "actions": [
            { "set": { "color": "WHITE", "size": "@SIZE[FORM_SMALL]", "end_time": 20 } },
            { "rotate": 90 },
            { "set": { "speed": 3.0, "limit_speed": 0.0, "acceleration": -1.0 } },
            { "respawn": true },
            { "next": "bug_light" }
          ]
        }
      ]
    },
    "bug_light": {
      "id": 3401,
      "on_end": [
        {
          "actions": [
            { "set": { "form": "LIGHT", "color": "YELLOW", "damage": 4.0, "size": "@SIZE[FORM_TINY]" } },
            { "respawn": true },
            { "next": "bug_flash" }
          ]
        }
      ]
    },
    "bug_flash": {
      "id": 3402,
      "on_tick": [
        {
          "when": { "every": 3 },
          "if": "shot.color == YELLOW",
          "actions": [ { "set": { "color": "WHITE", "size": "@SIZE[FORM_TINY]" } } ]
        },
        {
          "when": { "every": 3 },
          "if": "shot.color != YELLOW",
          "actions": [ { "set": { "color": "YELLOW", "size": "@SIZE[FORM_TINY]*2" } } ]
        }
      ],
      "on_end": [
        {
          "actions": [
            { "special_end": true },
            { "set": { "form": "RICE", "color": "YELLOW", "damage": 6.0, "size": "@SIZE[FORM_RICE]*2" } },
            { "rotate": -45 },
            { "set": { "angle_y": "sin(yawOf(angle.x, angle.z)*23)*0.3" } },
            { "update_angle": true },
            { "set": { "speed": 0.01, "limit_speed": 0.5, "acceleration": 0.02, "end_time": 80 } },
            { "respawn": true }
          ]
        }
      ]
    },
